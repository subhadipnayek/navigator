using Microsoft.AspNetCore.Mvc;
using NAVigator.Services;

namespace NAVigator.Controllers;

[ApiController]
[Route("api/[controller]")]
public class NavController(INavService navService) : ControllerBase
{
    /// <summary>
    /// Get NAV history for a fund by scheme code.
    /// Uses smart caching: serves from DB when possible,
    /// fetches from API only when needed, and respects a 1-hour cooldown.
    /// </summary>
    [HttpGet("{schemeCode:int}")]
    public async Task<IActionResult> GetNavHistory(int schemeCode, CancellationToken ct)
    {
        var result = await navService.GetNavHistoryAsync(schemeCode, ct);
        return result is null
            ? NotFound(new { message = $"Fund with scheme code {schemeCode} not found." })
            : Ok(result);
    }

    /// <summary>
    /// Get point-to-point returns (absolute + CAGR) for standard periods:
    /// 1M, 3M, 6M, 1Y, 2Y, 3Y, 5Y, 10Y, Since Inception.
    /// </summary>
    [HttpGet("{schemeCode:int}/returns")]
    public async Task<IActionResult> GetReturns(int schemeCode, CancellationToken ct)
    {
        var result = await navService.GetReturnsAsync(schemeCode, ct);
        return result is null
            ? NotFound(new { message = $"Fund with scheme code {schemeCode} not found." })
            : Ok(result);
    }

    /// <summary>
    /// Get rolling returns (annualized CAGR) for every possible window of the given period.
    /// Includes summary statistics: min, max, average, median.
    /// </summary>
    [HttpGet("{schemeCode:int}/rolling-returns")]
    public async Task<IActionResult> GetRollingReturns(
        int schemeCode,
        [FromQuery] int periodInYears = 1,
        CancellationToken ct = default)
    {
        if (periodInYears < 1 || periodInYears > 30)
            return BadRequest(new { message = "periodInYears must be between 1 and 30." });

        var result = await navService.GetRollingReturnsAsync(schemeCode, periodInYears, ct);
        return result is null
            ? NotFound(new { message = $"Fund with scheme code {schemeCode} not found." })
            : Ok(result);
    }

    /// <summary>
    /// Compare point-to-point returns for multiple funds side by side.
    /// Pass scheme codes as comma-separated query parameter: ?codes=119551,120438
    /// </summary>
    [HttpGet("compare")]
    public async Task<IActionResult> CompareReturns(
        [FromQuery] string codes,
        CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(codes))
            return BadRequest(new { message = "Query parameter 'codes' is required (comma-separated scheme codes)." });

        var schemeCodes = codes
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(c => int.TryParse(c, out var v) ? v : (int?)null)
            .Where(v => v.HasValue)
            .Select(v => v!.Value)
            .ToArray();

        if (schemeCodes.Length < 2)
            return BadRequest(new { message = "At least 2 valid scheme codes are required for comparison." });

        if (schemeCodes.Length > 10)
            return BadRequest(new { message = "Maximum 10 funds can be compared at once." });

        var result = await navService.CompareReturnsAsync(schemeCodes, ct);
        return Ok(result);
    }
}
