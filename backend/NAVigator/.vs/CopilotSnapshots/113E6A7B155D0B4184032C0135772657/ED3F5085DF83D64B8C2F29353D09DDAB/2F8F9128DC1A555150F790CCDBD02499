using Microsoft.AspNetCore.Mvc;
using NAVigator.Services;

namespace NAVigator.Controllers;

[ApiController]
[Route("api/[controller]")]
public class NavController(INavService navService) : ControllerBase
{
    /// <summary>
    /// Get NAV history for a fund by scheme code.
    /// Uses smart caching: serves from DB when possible,
    /// fetches from API only when needed, and respects a 1-hour cooldown.
    /// </summary>
    [HttpGet("{schemeCode:int}")]
    public async Task<IActionResult> GetNavHistory(int schemeCode, CancellationToken ct)
    {
        var result = await navService.GetNavHistoryAsync(schemeCode, ct);
        return result is null
            ? NotFound(new { message = $"Fund with scheme code {schemeCode} not found." })
            : Ok(result);
    }

    /// <summary>
    /// Get point-to-point returns (absolute + CAGR) between the specified dates.
    /// </summary>
    [HttpGet("{schemeCode:int}/returns")]
    public async Task<IActionResult> GetReturns(
        int schemeCode,
        [FromQuery] DateOnly startDate,
        [FromQuery] DateOnly endDate,
        CancellationToken ct)
    {
        if (startDate >= endDate)
            return BadRequest(new { message = "startDate must be before endDate." });

        var result = await navService.GetReturnsAsync(schemeCode, startDate, endDate, ct);
        return result is null
            ? NotFound(new { message = $"Fund with scheme code {schemeCode} not found." })
            : Ok(result);
    }

    /// <summary>
    /// Get rolling returns (annualized CAGR) for every possible window of the given period.
    /// Includes summary statistics: min, max, average, median.
    /// </summary>
    [HttpGet("{schemeCode:int}/rolling-returns")]
    public async Task<IActionResult> GetRollingReturns(
        int schemeCode,
        [FromQuery] int periodInYears = 1,
        CancellationToken ct = default)
    {
        if (periodInYears < 1 || periodInYears > 30)
            return BadRequest(new { message = "periodInYears must be between 1 and 30." });

        var result = await navService.GetRollingReturnsAsync(schemeCode, periodInYears, ct);
        return result is null
            ? NotFound(new { message = $"Fund with scheme code {schemeCode} not found." })
            : Ok(result);
    }

    /// <summary>
    /// Compare point-to-point returns for multiple funds between the specified dates.
    /// Pass scheme codes as comma-separated query parameter: ?codes=119551,120438&amp;startDate=2020-01-01&amp;endDate=2025-01-01
    /// </summary>
    [HttpGet("compare")]
    public async Task<IActionResult> CompareReturns(
        [FromQuery] string codes,
        [FromQuery] DateOnly startDate,
        [FromQuery] DateOnly endDate,
        CancellationToken ct)
    {
        if (startDate >= endDate)
            return BadRequest(new { message = "startDate must be before endDate." });

        if (!TryParseCodes(codes, out var schemeCodes, out var error))
            return BadRequest(new { message = error });

        var result = await navService.CompareReturnsAsync(schemeCodes, startDate, endDate, ct);
        return Ok(result);
    }

    /// <summary>
    /// Get "Growth of ₹10,000" chart data for multiple funds.
    /// All funds are rebased to ₹10,000 on the common start date so they
    /// can be plotted on the same Y-axis for visual comparison.
    /// Pass scheme codes as comma-separated: ?codes=119551,120438
    /// </summary>
    [HttpGet("compare/chart")]
    public async Task<IActionResult> CompareGrowthChart(
        [FromQuery] string codes,
        CancellationToken ct)
    {
        if (!TryParseCodes(codes, out var schemeCodes, out var error))
            return BadRequest(new { message = error });

        var result = await navService.GetGrowthChartAsync(schemeCodes, ct);
        return Ok(result);
    }

    /// <summary>
    /// Compare rolling returns for multiple funds on a single chart.
    /// Pass scheme codes as comma-separated: ?codes=119551,120438&amp;periodInYears=3
    /// </summary>
    [HttpGet("compare/rolling-returns")]
    public async Task<IActionResult> CompareRollingReturns(
        [FromQuery] string codes,
        [FromQuery] int periodInYears = 1,
        CancellationToken ct = default)
    {
        if (periodInYears < 1 || periodInYears > 30)
            return BadRequest(new { message = "periodInYears must be between 1 and 30." });

        if (!TryParseCodes(codes, out var schemeCodes, out var error))
            return BadRequest(new { message = error });

        var result = await navService.CompareRollingReturnsAsync(schemeCodes, periodInYears, ct);
        return Ok(result);
    }

    private static bool TryParseCodes(string? codes, out int[] schemeCodes, out string? error)
    {
        schemeCodes = [];
        error = null;

        if (string.IsNullOrWhiteSpace(codes))
        {
            error = "Query parameter 'codes' is required (comma-separated scheme codes).";
            return false;
        }

        schemeCodes = codes
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(c => int.TryParse(c, out var v) ? v : (int?)null)
            .Where(v => v.HasValue)
            .Select(v => v!.Value)
            .ToArray();

        if (schemeCodes.Length < 2)
        {
            error = "At least 2 valid scheme codes are required for comparison.";
            return false;
        }

        if (schemeCodes.Length > 10)
        {
            error = "Maximum 10 funds can be compared at once.";
            return false;
        }

        return true;
    }
}
