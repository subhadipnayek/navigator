using System.Collections.Concurrent;
using System.Globalization;
using NAVigator.Models.Database;
using NAVigator.Models.Dto;
using NAVigator.Repositories;

namespace NAVigator.Services;

public class NavService(
    INavHistoryRepository navRepo,
    IFundRepository fundRepo,
    IAmfiService amfiService,
    ILogger<NavService> logger) : INavService
{
    /// <summary>
    /// Cooldown period: if we checked the API and found no new data,
    /// don't hit the API again for this fund until this duration elapses.
    /// </summary>
    private static readonly TimeSpan ApiCooldown = TimeSpan.FromHours(1);

    /// <summary>
    /// Per-scheme lock to prevent concurrent API fetches and DB inserts for the same fund.
    /// </summary>
    private static readonly ConcurrentDictionary<int, SemaphoreSlim> SchemeLocks = new();

    public async Task<NavDataResponse?> GetNavHistoryAsync(int schemeCode, CancellationToken ct = default)
    {
        // 1. Verify the fund exists in our master list
        var fund = await fundRepo.GetBySchemeCodeAsync(schemeCode);
        if (fund is null)
        {
            logger.LogWarning("Fund {SchemeCode} not found in database", schemeCode);
            return null;
        }

        // Acquire a per-scheme lock so concurrent requests for the same fund
        // don't race through the check-then-insert sequence simultaneously.
        var schemeLock = SchemeLocks.GetOrAdd(schemeCode, _ => new SemaphoreSlim(1, 1));
        await schemeLock.WaitAsync(ct);
        try
        {
            // 2. Get latest NAV date from DB
            var latestDbDate = await navRepo.GetLatestNavDateAsync(schemeCode);
            var today = DateOnly.FromDateTime(TimeZoneInfo.ConvertTimeFromUtc(
                DateTime.UtcNow, TimeZoneInfo.FindSystemTimeZoneById("India Standard Time")));

            // 3. If latest NAV in DB is today, serve from DB — no API call needed
            if (latestDbDate.HasValue && latestDbDate.Value >= today)
            {
                logger.LogDebug("Fund {SchemeCode}: NAV is current ({Date}), serving from DB", schemeCode, latestDbDate);
                return await BuildResponseFromDb(fund, false);
            }

            // 4. Check cooldown tracker — should we call the API?
            var tracker = await navRepo.GetSyncTrackerAsync(schemeCode);
            bool shouldCallApi = ShouldCallApi(tracker, today);

            if (!shouldCallApi)
            {
                logger.LogDebug(
                    "Fund {SchemeCode}: API on cooldown (last check: {LastCheck}), serving from DB",
                    schemeCode, tracker?.LastApiCheckUtc);
                return await BuildResponseFromDb(fund, false);
            }

            // 5. Call the external API
            logger.LogInformation("Fund {SchemeCode}: Fetching NAV history from API", schemeCode);
            var apiResponse = await amfiService.FetchNavHistoryAsync(schemeCode, ct);

            if (apiResponse is null || apiResponse.Data.Count == 0)
            {
                // API failed or returned empty — mark tracker so we don't retry immediately
                await navRepo.UpsertSyncTrackerAsync(new NavSyncTracker
                {
                    SchemeCode = schemeCode,
                    LastApiCheckUtc = DateTime.UtcNow,
                    LatestNavDateFromApi = latestDbDate,
                    LastCheckHadNewData = false
                });

                return await BuildResponseFromDb(fund, false);
            }

            // 6. Parse and store new NAV entries
            var newEntries = new List<NavHistory>();
            DateOnly? apiLatestDate = null;

            foreach (var entry in apiResponse.Data)
            {
                if (!DateOnly.TryParseExact(entry.Date, "dd-MM-yyyy", CultureInfo.InvariantCulture,
                        DateTimeStyles.None, out var date))
                    continue;

                if (!decimal.TryParse(entry.Nav, CultureInfo.InvariantCulture, out var nav))
                    continue;

                if (apiLatestDate is null || date > apiLatestDate)
                    apiLatestDate = date;

                // Only add entries newer than what we already have
                if (!latestDbDate.HasValue || date > latestDbDate.Value)
                {
                    newEntries.Add(new NavHistory
                    {
                        SchemeCode = schemeCode,
                        Date = date,
                        Nav = nav
                    });
                }
            }

            bool hadNewData = newEntries.Count > 0;

            if (hadNewData)
            {
                await navRepo.AddRangeAsync(newEntries);
                logger.LogInformation("Fund {SchemeCode}: Stored {Count} new NAV entries", schemeCode, newEntries.Count);
            }
            else
            {
                logger.LogDebug("Fund {SchemeCode}: API had no newer data than DB ({DbDate})", schemeCode, latestDbDate);
            }

            // 7. Update the sync tracker
            await navRepo.UpsertSyncTrackerAsync(new NavSyncTracker
            {
                SchemeCode = schemeCode,
                LastApiCheckUtc = DateTime.UtcNow,
                LatestNavDateFromApi = apiLatestDate ?? latestDbDate,
                LastCheckHadNewData = hadNewData
            });

            return await BuildResponseFromDb(fund, true);
        }
        finally
        {
            schemeLock.Release();
        }
    }

    /// <summary>
    /// Determines whether we should call the external API based on the sync tracker state.
    /// </summary>
    private static bool ShouldCallApi(NavSyncTracker? tracker, DateOnly today)
    {
        // Never checked before — definitely call
        if (tracker is null)
            return true;

        // If the last check DID return new data and the latest date from API is today,
        // no need to check again today
        if (tracker.LastCheckHadNewData && tracker.LatestNavDateFromApi.HasValue
            && tracker.LatestNavDateFromApi.Value >= today)
            return false;

        // If the last check had NO new data, enforce cooldown
        if (!tracker.LastCheckHadNewData)
        {
            var elapsed = DateTime.UtcNow - tracker.LastApiCheckUtc;
            if (elapsed < ApiCooldown)
                return false;
        }

        return true;
    }

    private async Task<NavDataResponse> BuildResponseFromDb(Fund fund, bool wasFetchedFromApi)
    {
        var histories = await navRepo.GetBySchemeCodeAsync(fund.SchemeCode);
        return new NavDataResponse
        {
            SchemeCode = fund.SchemeCode,
            SchemeName = fund.SchemeName,
            FundHouse = fund.FundHouse,
            LatestNavDate = histories.Count > 0
                ? histories[0].Date.ToString("dd-MM-yyyy")
                : null,
            WasFetchedFromApi = wasFetchedFromApi,
            Data = histories.Select(h => new NavHistoryDto
            {
                Date = h.Date.ToString("dd-MM-yyyy"),
                Nav = h.Nav
            }).ToList()
        };
    }

    public async Task<ReturnsResponse?> GetReturnsAsync(int schemeCode, CancellationToken ct = default)
    {
        // Ensure NAV data is up-to-date
        var navResponse = await GetNavHistoryAsync(schemeCode, ct);
        if (navResponse is null)
            return null;

        var fund = (await fundRepo.GetBySchemeCodeAsync(schemeCode))!;
        var histories = await navRepo.GetBySchemeCodeAsync(schemeCode);

        if (histories.Count == 0)
            return new ReturnsResponse
            {
                SchemeCode = schemeCode,
                SchemeName = fund.SchemeName,
                FundHouse = fund.FundHouse
            };

        // Build a date -> NAV lookup sorted ascending
        var navByDate = histories
            .OrderBy(h => h.Date)
            .ToList();

        var latestDate = navByDate[^1].Date;
        var latestNav = navByDate[^1].Nav;
        var inceptionDate = navByDate[0].Date;
        var inceptionNav = navByDate[0].Nav;

        var periods = new (string Label, DateOnly TargetStart)[]
        {
            ("1M", latestDate.AddMonths(-1)),
            ("3M", latestDate.AddMonths(-3)),
            ("6M", latestDate.AddMonths(-6)),
            ("1Y", latestDate.AddYears(-1)),
            ("2Y", latestDate.AddYears(-2)),
            ("3Y", latestDate.AddYears(-3)),
            ("5Y", latestDate.AddYears(-5)),
            ("10Y", latestDate.AddYears(-10)),
        };

        var returns = new List<ReturnPeriodDto>();

        foreach (var (label, targetStart) in periods)
        {
            var startEntry = FindClosestNav(navByDate, targetStart);
            if (startEntry is null || startEntry.Date >= latestDate)
            {
                returns.Add(new ReturnPeriodDto { Period = label });
                continue;
            }

            var absoluteReturn = (latestNav - startEntry.Nav) / startEntry.Nav * 100m;
            var days = latestDate.DayNumber - startEntry.Date.DayNumber;
            decimal? cagr = days > 0
                ? (decimal)(Math.Pow((double)(latestNav / startEntry.Nav), 365.25 / days) - 1) * 100m
                : null;

            returns.Add(new ReturnPeriodDto
            {
                Period = label,
                AbsoluteReturn = Math.Round(absoluteReturn, 2),
                Cagr = cagr.HasValue ? Math.Round(cagr.Value, 2) : null,
                StartDate = startEntry.Date.ToString("dd-MM-yyyy"),
                StartNav = startEntry.Nav,
                EndDate = latestDate.ToString("dd-MM-yyyy"),
                EndNav = latestNav
            });
        }

        // Since Inception
        if (inceptionDate < latestDate)
        {
            var absoluteReturn = (latestNav - inceptionNav) / inceptionNav * 100m;
            var days = latestDate.DayNumber - inceptionDate.DayNumber;
            decimal? cagr = days > 0
                ? (decimal)(Math.Pow((double)(latestNav / inceptionNav), 365.25 / days) - 1) * 100m
                : null;

            returns.Add(new ReturnPeriodDto
            {
                Period = "SI",
                AbsoluteReturn = Math.Round(absoluteReturn, 2),
                Cagr = cagr.HasValue ? Math.Round(cagr.Value, 2) : null,
                StartDate = inceptionDate.ToString("dd-MM-yyyy"),
                StartNav = inceptionNav,
                EndDate = latestDate.ToString("dd-MM-yyyy"),
                EndNav = latestNav
            });
        }

        return new ReturnsResponse
        {
            SchemeCode = schemeCode,
            SchemeName = fund.SchemeName,
            FundHouse = fund.FundHouse,
            Returns = returns
        };
    }

    public async Task<RollingReturnResponse?> GetRollingReturnsAsync(int schemeCode, int periodInYears, CancellationToken ct = default)
    {
        // Ensure NAV data is up-to-date
        var navResponse = await GetNavHistoryAsync(schemeCode, ct);
        if (navResponse is null)
            return null;

        var fund = (await fundRepo.GetBySchemeCodeAsync(schemeCode))!;
        var histories = await navRepo.GetBySchemeCodeAsync(schemeCode);

        if (histories.Count == 0)
            return new RollingReturnResponse
            {
                SchemeCode = schemeCode,
                SchemeName = fund.SchemeName,
                FundHouse = fund.FundHouse,
                PeriodInYears = periodInYears
            };

        // Sort ascending by date
        var navByDate = histories.OrderBy(h => h.Date).ToList();

        // Build a dictionary for O(1) date lookups
        var navLookup = navByDate.ToDictionary(h => h.Date, h => h.Nav);

        var rollingReturns = new List<RollingReturnDto>();

        foreach (var entry in navByDate)
        {
            var startDate = entry.Date.AddYears(-periodInYears);

            // Find the closest available NAV date to the target start date (within 7 days tolerance)
            var startNav = FindClosestNavValue(navByDate, startDate, toleranceDays: 7);
            if (startNav is null)
                continue;

            var days = entry.Date.DayNumber - startDate.DayNumber;
            if (days <= 0 || startNav.Value.Nav <= 0)
                continue;

            var cagr = (decimal)(Math.Pow((double)(entry.Nav / startNav.Value.Nav), 365.25 / days) - 1) * 100m;

            rollingReturns.Add(new RollingReturnDto
            {
                Date = entry.Date.ToString("dd-MM-yyyy"),
                ReturnPercentage = Math.Round(cagr, 2)
            });
        }

        decimal? min = null, max = null, avg = null, median = null;
        if (rollingReturns.Count > 0)
        {
            var values = rollingReturns.Select(r => r.ReturnPercentage).OrderBy(v => v).ToList();
            min = values[0];
            max = values[^1];
            avg = Math.Round(values.Average(), 2);
            median = values.Count % 2 == 0
                ? Math.Round((values[values.Count / 2 - 1] + values[values.Count / 2]) / 2m, 2)
                : values[values.Count / 2];
        }

        return new RollingReturnResponse
        {
            SchemeCode = schemeCode,
            SchemeName = fund.SchemeName,
            FundHouse = fund.FundHouse,
            PeriodInYears = periodInYears,
            DataPoints = rollingReturns.Count,
            MinReturn = min,
            MaxReturn = max,
            AverageReturn = avg,
            MedianReturn = median,
            Data = rollingReturns
        };
    }

    public async Task<ComparisonResponse> CompareReturnsAsync(int[] schemeCodes, CancellationToken ct = default)
    {
        var response = new ComparisonResponse();

        foreach (var code in schemeCodes)
        {
            var returns = await GetReturnsAsync(code, ct);
            if (returns is not null)
                response.Funds.Add(returns);
        }

        return response;
    }

    public async Task<GrowthChartResponse> GetGrowthChartAsync(int[] schemeCodes, CancellationToken ct = default)
    {
        // 1. Ensure NAV data is fresh for every fund
        var fundNavs = new List<(Fund Fund, List<NavHistory> Histories)>();

        foreach (var code in schemeCodes)
        {
            await GetNavHistoryAsync(code, ct); // triggers API fetch if needed
            var fund = await fundRepo.GetBySchemeCodeAsync(code);
            if (fund is null) continue;

            var histories = await navRepo.GetBySchemeCodeAsync(code);
            if (histories.Count == 0) continue;

            fundNavs.Add((fund, histories.OrderBy(h => h.Date).ToList()));
        }

        if (fundNavs.Count == 0)
            return new GrowthChartResponse();

        // 2. Find the common date range (latest start, earliest end)
        var commonStart = fundNavs.Max(f => f.Histories[0].Date);
        var commonEnd = fundNavs.Min(f => f.Histories[^1].Date);

        if (commonStart >= commonEnd)
            return new GrowthChartResponse();

        // 3. Rebase each fund to 10,000 at the common start date
        var response = new GrowthChartResponse
        {
            CommonStartDate = commonStart.ToString("dd-MM-yyyy"),
            CommonEndDate = commonEnd.ToString("dd-MM-yyyy"),
            BaseAmount = 10000m
        };

        foreach (var (fund, histories) in fundNavs)
        {
            var baseEntry = FindClosestNav(histories, commonStart);
            if (baseEntry is null || baseEntry.Nav <= 0) continue;

            var baseNav = baseEntry.Nav;

            var series = new FundChartSeriesDto
            {
                SchemeCode = fund.SchemeCode,
                SchemeName = fund.SchemeName,
                FundHouse = fund.FundHouse,
                Data = histories
                    .Where(h => h.Date >= commonStart && h.Date <= commonEnd)
                    .Select(h => new ChartPointDto
                    {
                        Date = h.Date.ToString("dd-MM-yyyy"),
                        Value = Math.Round(h.Nav / baseNav * 10000m, 2)
                    })
                    .ToList()
            };

            response.Funds.Add(series);
        }

        return response;
    }

    public async Task<RollingReturnCompareResponse> CompareRollingReturnsAsync(
        int[] schemeCodes, int periodInYears, CancellationToken ct = default)
    {
        var response = new RollingReturnCompareResponse { PeriodInYears = periodInYears };

        foreach (var code in schemeCodes)
        {
            var rolling = await GetRollingReturnsAsync(code, periodInYears, ct);
            if (rolling is null) continue;

            response.Funds.Add(new RollingReturnSeriesDto
            {
                SchemeCode = rolling.SchemeCode,
                SchemeName = rolling.SchemeName,
                FundHouse = rolling.FundHouse,
                MinReturn = rolling.MinReturn,
                MaxReturn = rolling.MaxReturn,
                AverageReturn = rolling.AverageReturn,
                MedianReturn = rolling.MedianReturn,
                Data = rolling.Data
            });
        }

        return response;
    }

    /// <summary>
    /// Finds the NAV entry closest to the target date (on or before, within 7 days).
    /// </summary>
    private static NavHistory? FindClosestNav(List<NavHistory> sortedAsc, DateOnly targetDate)
    {
        // Binary search for the target date
        int idx = sortedAsc.BinarySearch(null!, Comparer<NavHistory?>.Create((a, b) =>
        {
            var dateA = a?.Date ?? targetDate;
            var dateB = b?.Date ?? targetDate;
            return dateA.CompareTo(dateB);
        }));

        if (idx >= 0)
            return sortedAsc[idx];

        // ~idx is the index of the next element greater than target
        int insertionPoint = ~idx;

        // We want the entry on or just before the target date
        if (insertionPoint > 0)
        {
            var candidate = sortedAsc[insertionPoint - 1];
            if (targetDate.DayNumber - candidate.Date.DayNumber <= 7)
                return candidate;
        }

        // Or the entry just after (within 7 days)
        if (insertionPoint < sortedAsc.Count)
        {
            var candidate = sortedAsc[insertionPoint];
            if (candidate.Date.DayNumber - targetDate.DayNumber <= 7)
                return candidate;
        }

        return null;
    }

    /// <summary>
    /// Finds the NAV value closest to the target date within the specified tolerance.
    /// </summary>
    private static (DateOnly Date, decimal Nav)? FindClosestNavValue(List<NavHistory> sortedAsc, DateOnly targetDate, int toleranceDays)
    {
        var entry = FindClosestNav(sortedAsc, targetDate);
        if (entry is null)
            return null;

        if (Math.Abs(entry.Date.DayNumber - targetDate.DayNumber) <= toleranceDays)
            return (entry.Date, entry.Nav);

        return null;
    }
}
